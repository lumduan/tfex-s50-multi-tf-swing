# TFEX S50 Multi-TF Swing — environment configuration template.
# Copy to .env and fill in values for owner / private mode. NEVER commit a real .env.
# Every variable here is read by `pydantic-settings` via the
# `TFEX_S50_MULTI_TF_SWING_` prefix.

# --- Operating mode ---------------------------------------------------------
# Public mode (true) disables write/data-fetch endpoints and is safe to expose.
# Set to false only in owner deployments that need to refresh data, run backtests,
# or POST daily reports to the gateway.
TFEX_S50_MULTI_TF_SWING_PUBLIC_MODE=true

# --- quant-infra-db / gateway write-back (opt-in) ---------------------------
# Master switch. When false, adapter hooks are no-ops regardless of the DSN/URL
# settings below. When true, GATEWAY_BASE_URL + GATEWAY_API_KEY are required;
# PG_DSN is required only for strategy-owned tables (equity_curve, trade_history,
# backtest_log, benchmark_equity_curve) — gateway tables are NEVER written
# directly; they go via HTTP only.
TFEX_S50_MULTI_TF_SWING_DB_WRITE_ENABLED=false

# Gateway base URL. Inside Docker on `quant-network`, use the service hostname.
# From the host, override to http://localhost:8000.
TFEX_S50_MULTI_TF_SWING_GATEWAY_BASE_URL=http://quant-api-gateway:8000

# Shared INTERNAL_API_KEY exposed by the gateway. Sent as the X-API-Key header
# on every POST /api/v1/ingest/daily-report. Required when DB_WRITE_ENABLED=true.
# TFEX_S50_MULTI_TF_SWING_GATEWAY_API_KEY=replace-with-shared-internal-api-key

# Strategy-owned Postgres DSN. Inside Docker on `quant-network`, host is
# `quant-postgres`. Required when DB_WRITE_ENABLED=true and the strategy needs
# to write equity_curve / trade_history / backtest_log / benchmark_equity_curve
# / ohlcv_raw / ohlcv_continuous.
# TFEX_S50_MULTI_TF_SWING_PG_DSN=postgresql://postgres:<pass>@quant-postgres:5432/db_tfex_s50_multi_tf_swing

# --- Phase 1: data infrastructure -------------------------------------------
# Local directory for Parquet OHLCV (raw / cleaned / continuous / validation).
# Inside Docker this is a named volume; on the host, a relative path is fine.
TFEX_S50_MULTI_TF_SWING_DATA_DIR=./data

# TradingView session-cookie blob, JSON-encoded on a single line.
# Required for >5,000-bar fetches per symbol — i.e. the 5-year 5m backfill.
# Extract from your browser devtools → Application → Cookies → tradingview.com.
# Required key: sessionid. Recommended companions: sessionid_sign, device_t, tv_ecuid.
# TFEX_S50_MULTI_TF_SWING_TVKIT_AUTH_TOKEN={"sessionid":"...","sessionid_sign":"...","device_t":"...","tv_ecuid":"..."}

# Max concurrent tvkit fetches. 4 is plenty for end-of-day refreshes; raising
# it past ~8 risks rate-limiting from TradingView.
TFEX_S50_MULTI_TF_SWING_DATA_FETCH_CONCURRENCY=4

# How many trading days BEFORE expiry the continuous-contract roll occurs.
# Default 5 follows ROADMAP §1.2. Set to 0 to roll exactly on expiry day.
TFEX_S50_MULTI_TF_SWING_ROLL_OFFSET_DAYS=5

# --- Phase 4: market data engine source -------------------------------------
# OHLCV acquisition source. 'mirror' (default) keeps the unchanged Phase-1 tvkit
# path (Parquet + 09 TimescaleDB mirror). 'engine' reads RAW per-dated-contract
# bars from the shared quant-marketdata-engine read API (gateway-proxied) and
# builds the back-adjusted continuous locally — no tvkit cookie needed, and the
# 09 mirror becomes a derived cache. See feature-market-data-engine Phase 4.
TFEX_S50_MULTI_TF_SWING_OHLCV_SOURCE=mirror

# Market Data Engine read API base URL, AS PROXIED BY THE GATEWAY (include the
# /api/v2/engines/market-data prefix). Required when OHLCV_SOURCE=engine.
# In-cluster: http://quant-api-gateway:8000/api/v2/engines/market-data
# Host-local dev: http://localhost:8080/api/v2/engines/market-data
# TFEX_S50_MULTI_TF_SWING_MARKET_DATA_ENGINE_BASE_URL=http://quant-api-gateway:8000/api/v2/engines/market-data

# Optional X-API-Key forwarded to the engine read API (only needed when the
# engine sets its own MARKETDATA_ENGINE_API_KEY). Never logged.
# TFEX_S50_MULTI_TF_SWING_MARKET_DATA_ENGINE_API_KEY=replace-with-shared-internal-api-key

# --- Phase 3: regime-detection thresholds -----------------------------------
# Cutoffs for the rule-based regime classifier (regime/rules.py). Defaults match
# .claude/knowledge/regime-detection.md; override only with a labelled-data reason.
# panic when realised-vol percentile exceeds this (0..1).
TFEX_S50_MULTI_TF_SWING_REGIME_PANIC_RV=0.95
# panic when the trailing volume z-score exceeds this.
TFEX_S50_MULTI_TF_SWING_REGIME_PANIC_VOLUME_Z=3.0
# range_low_vol requires rv-percentile below this (0..1) AND range compression.
TFEX_S50_MULTI_TF_SWING_REGIME_RANGE_LOW_RV=0.30
# range_high_vol requires rv-percentile above this (0..1).
TFEX_S50_MULTI_TF_SWING_REGIME_RANGE_HIGH_RV=0.70
# minimum |trend_persistence| (0..1) below which a tape is treated as non-trending.
TFEX_S50_MULTI_TF_SWING_REGIME_TREND_PERSIST_MIN=0.30

# --- Phase 4: HTF bias-engine deadbands -------------------------------------
# Noise bands (ATR-normalised) a gate must exceed before it votes directionally.
# Both default to 0.0 → a strict sign test; raise to suppress chop near zero.
# The bias engine vetoes counter-trend trades; it never generates trades.
TFEX_S50_MULTI_TF_SWING_BIAS_SLOPE_DEADBAND=0.0
TFEX_S50_MULTI_TF_SWING_BIAS_VWAP_DEADBAND=0.0

# --- Phase 5: setup-detection (signal) gates --------------------------------
# Thresholds for strategies A/B/C (signals/). Defaults reproduce the documented
# strategy-design behaviour; override only with a backtested reason.
# A — 1H pullback: max |dist-from-VWAP| (ATR units) and the ATR/volume contraction caps.
TFEX_S50_MULTI_TF_SWING_SIGNAL_PULLBACK_BAND=1.0
TFEX_S50_MULTI_TF_SWING_SIGNAL_ATR_CONTRACTION_MAX=1.0
TFEX_S50_MULTI_TF_SWING_SIGNAL_VOLUME_CONTRACTION_MAX=0.5
# A — 5m compression: bollinger-squeeze and ATR-ratio ceilings.
TFEX_S50_MULTI_TF_SWING_SIGNAL_SQUEEZE_MAX=1.0
TFEX_S50_MULTI_TF_SWING_SIGNAL_ATR_COMPRESSION_MAX=1.0
# Shared 5m trigger: min trailing volume z-score for "expansion".
TFEX_S50_MULTI_TF_SWING_SIGNAL_VOLUME_EXPANSION_MIN=1.0
# B — opening-range window in minutes (must be a pipeline opening_range_minutes value).
TFEX_S50_MULTI_TF_SWING_SIGNAL_OR_WINDOW=15
# C — require the post-sweep 5m structure to have shifted to the reversal side.
TFEX_S50_MULTI_TF_SWING_SIGNAL_REQUIRE_STRUCTURE_SHIFT=true
# Lookback (5m bars) for the causal swing high/low used as the structure stop anchor.
TFEX_S50_MULTI_TF_SWING_SIGNAL_SWING_WINDOW=12

# --- Phase 5: execution engine ----------------------------------------------
# 5m trade-simulation knobs (execution/). PnL is in points + R only (no THB, no costs).
TFEX_S50_MULTI_TF_SWING_EXECUTION_K_ATR_STOP=1.5
TFEX_S50_MULTI_TF_SWING_EXECUTION_PARTIAL_TP_R=1.0
TFEX_S50_MULTI_TF_SWING_EXECUTION_PARTIAL_FRACTION=0.5
TFEX_S50_MULTI_TF_SWING_EXECUTION_BREAKEVEN_BUFFER=0.0
TFEX_S50_MULTI_TF_SWING_EXECUTION_TRAIL_ATR_MULT=1.5
TFEX_S50_MULTI_TF_SWING_EXECUTION_TIME_STOP_BARS=24
TFEX_S50_MULTI_TF_SWING_EXECUTION_MAX_SPREAD_MULT=3.0

# --- Phase 7: risk engine ---------------------------------------------------
# Sizing, daily/streak limits, volatility scaling, kill switch, and the capital
# deployment ladder (risk/). Defaults reproduce .claude/knowledge/risk-engine.md;
# an unset env is a no-op. The S50 multiplier (200 THB/point) is a code constant
# (risk/sizing.py), never an env var.
# Fraction of equity risked per trade (1% default).
TFEX_S50_MULTI_TF_SWING_RISK_PER_TRADE_PCT=0.01
# Cumulative R loss that halts the session for the day (positive number → halt at -NR).
TFEX_S50_MULTI_TF_SWING_RISK_DAILY_LOSS_LIMIT_R=2.0
# Consecutive losses that pause trading until the next session.
TFEX_S50_MULTI_TF_SWING_RISK_MAX_CONSECUTIVE_LOSSES=3
# Daily trade-count cap (anti-tilt).
TFEX_S50_MULTI_TF_SWING_RISK_MAX_TRADES_PER_DAY=6
# Realised-vol percentile (0..1) at/above which size is scaled by the factor below.
TFEX_S50_MULTI_TF_SWING_RISK_HIGH_VOL_PERCENTILE=0.70
TFEX_S50_MULTI_TF_SWING_RISK_HIGH_VOL_SIZE_FACTOR=0.5
# When true, the panic regime is no-trade (stricter than the regime policy's ≤50%).
TFEX_S50_MULTI_TF_SWING_RISK_PANIC_NO_TRADE=true
# Manual kill switch — true flattens positions and halts entries. The admin endpoint
# is deferred until the api/ package lands; this env flag is the only override today.
TFEX_S50_MULTI_TF_SWING_RISK_KILL_SWITCH_ENGAGED=false
# Kill-switch budgets: spread anomaly (× rolling median), latency (ms), error rate (0..1).
TFEX_S50_MULTI_TF_SWING_RISK_SPREAD_ANOMALY_MULT=5.0
TFEX_S50_MULTI_TF_SWING_RISK_LATENCY_BUDGET_MS=500.0
TFEX_S50_MULTI_TF_SWING_RISK_MAX_ERROR_RATE=0.10
# Capital-deployment ladder: stage + per-stage contract caps + evidence thresholds.
# Stage one of: paper | micro_live | validated | scale. No scaling without evidence.
TFEX_S50_MULTI_TF_SWING_RISK_DEPLOYMENT_STAGE=paper
TFEX_S50_MULTI_TF_SWING_RISK_MICRO_LIVE_MAX_CONTRACTS=1
TFEX_S50_MULTI_TF_SWING_RISK_VALIDATED_MAX_CONTRACTS=2
TFEX_S50_MULTI_TF_SWING_RISK_SCALE_MAX_CONTRACTS=4
TFEX_S50_MULTI_TF_SWING_RISK_VALIDATED_MIN_MONTHS_LIVE=6.0
TFEX_S50_MULTI_TF_SWING_RISK_SCALE_MIN_MONTHS_LIVE=12.0

# Phase 8 — walk-forward harness. Anchored windows (never random/k-fold). 'anchored' = train
# start fixed + expanding; 'rolling' = fixed-width train start rolling forward. Spans in days.
TFEX_S50_MULTI_TF_SWING_WALK_FORWARD_MODE=anchored
TFEX_S50_MULTI_TF_SWING_WALK_FORWARD_TRAIN_SPAN_DAYS=1095
TFEX_S50_MULTI_TF_SWING_WALK_FORWARD_TEST_SPAN_DAYS=365
TFEX_S50_MULTI_TF_SWING_WALK_FORWARD_STEP_DAYS=365
TFEX_S50_MULTI_TF_SWING_WALK_FORWARD_START_EQUITY=200000
TFEX_S50_MULTI_TF_SWING_WALK_FORWARD_SEED=42
TFEX_S50_MULTI_TF_SWING_WALK_FORWARD_REFIT_ML=false

# Phase 8 — cost model. THB fees are Decimal (round-trip per contract); slippage is ATR-scaled
# and worse on illiquid sessions; spread is tick-based. A backtest without costs is marketing.
TFEX_S50_MULTI_TF_SWING_COST_COMMISSION_PER_CONTRACT=85
TFEX_S50_MULTI_TF_SWING_COST_CLEARING_FEE_PER_CONTRACT=1
TFEX_S50_MULTI_TF_SWING_COST_SLIPPAGE_ATR_MULT=0.05
TFEX_S50_MULTI_TF_SWING_COST_ILLIQUID_SESSION_MULT=2.0
TFEX_S50_MULTI_TF_SWING_COST_TICK_SIZE=0.1
TFEX_S50_MULTI_TF_SWING_COST_SPREAD_TICKS=1.0
